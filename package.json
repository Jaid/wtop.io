{
  "name": "wtop.io",
  "displayName": "Wtop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A browser-native Linux host monitor powered by a short-lived Docker collector",
  "homepage": "https://wtop.io",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/wtop.io.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.tsx"
    }
  },
  "imports": {
    "#component/*": "./src/components/*/index.tsx",
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun run generate && bun run vite build",
    "build:dev": "bun run generate && bun run vite build --mode development",
    "check:unused": "knip-bun",
    "dev": "bun run vite",
    "generate": "bun scripts/embedCollector.ts",
    "lint": "bun run generate --check && bun run typecheck && bun run check:unused && bun run lint:style",
    "lint:style": "bun --bun node_modules/eslint/bin/eslint.js .",
    "preview": "bun run vite preview",
    "smoke:docker": "bun scripts/smokeDocker.ts",
    "test": "bun scripts/test.ts",
    "test:browser": "bun run build && bun test ./test/production.browser.ts",
    "test:collector": "bun scripts/testCollector.ts",
    "test:dom": "bun test --preload ./test/happydom.ts ./test/components.dom.ts",
    "test:unit": "bun test --max-concurrency 1 ./test/unit",
    "test-live": "bun run test:browser",
    "typecheck": "tsc --noEmit --noUnusedLocals --pretty false",
    "validate": "bun run lint && bun run test && bun run test:browser",
    "vite": "bun node_modules/vite/dist/node/cli.js --configLoader runner"
  },
  "dependencies": {
    "antimono": "0.1.0",
    "clsx": "2.1.1",
    "mount-root": "0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "read-permalink": "0.4.0",
    "wouter": "3.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cssnano-preset-advanced": "9.1.1",
    "eslint": "10.11.0",
    "eslint-config-jaid": "34.0.0",
    "fs-extra": "11.4.1",
    "knip": "6.38.0",
    "postcss-normalize": "13.0.1",
    "puppeteer-core": "25.12.0",
    "sass-embedded": "1.105.0",
    "tsconfig-jaid-react": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.1",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0",
    "@babel/core": "8.0.6",
    "@happy-dom/global-registrator": "20.14.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/fs-extra": "11.0.4",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
